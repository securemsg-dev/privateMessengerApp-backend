# ============================================================
# Private Messenger App — Environment Configuration
# ============================================================
# Copy this file to .env.local (development) and fill in real values.
# NEVER commit env files to version control.
# In production (Railway), set these as service variables instead.
# ============================================================

# --- App ---
APP_ENV=development          # development | staging | production
APP_NAME="Cricchat"
DEBUG=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/private_messenger
# Railway supplies postgresql:// — the app rewrites it to +asyncpg automatically.

# Connection health check before every request. Costs 3 extra DB round trips
# per request, so it is off; connections are recycled by age instead.
DB_POOL_PRE_PING=false
DB_POOL_RECYCLE_SECONDS=300

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Caching / performance ---
# Redis read cache master switch. Set false to bypass the cache instantly.
CACHE_ENABLED=true
CACHE_OP_TIMEOUT_SECONDS=0.2
# Log one "[perf]" line per HTTP request (duration, DB round trips, cache
# hits). Turn on for staging or a short measurement window.
PERF_LOGGING_ENABLED=false

# --- JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Rate limiting ---
# Keep true in production. Set false ONLY for single-IP load tests.
RATE_LIMITING_ENABLED=true

# --- Public legal pages (/privacy, /delete-account, /report-abuse) ---
# Google Play requires all three pages to be reachable in a browser, and
# reviewers may email the addresses below — both must be monitored inboxes in
# production.
SUPPORT_EMAIL=support@example.com
# Abuse-report inbox published on /report-abuse. Leave blank to reuse
# SUPPORT_EMAIL (fine while one person handles both).
ABUSE_EMAIL=
# Published turnaround for abuse reports, in hours. This is a commitment to
# Google — don't lower it below what you can actually meet.
ABUSE_RESPONSE_HOURS=24
# Data controller named in the privacy policy, e.g. "Acme Pte. Ltd.,
# registered in Singapore". Leave blank to omit the sentence entirely.
# Deployed value: "Secure Messenger Admin (Malaysia)" — a trading name, since
# the operator is an individual rather than a registered company.
LEGAL_ENTITY_NAME=
# TURN relay vendor disclosed as a service provider. Deployed value:
# "Metered.ca" (matches WEBRTC_TURN_URL -> *.relay.metered.ca).
# Leave blank for an unnamed but accurate description.
TURN_PROVIDER_NAME=

# --- Media storage ---
# Backend for NEW blobs: "local" writes encrypted blobs to MEDIA_LOCAL_PATH
# (needs a persistent volume in production); "s3" uses the bucket below with
# presigned direct uploads. Blobs remember where they were stored, so keep
# MEDIA_LOCAL_PATH mounted after switching to s3 — older media lives there.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_PATH=./uploads

# --- WebRTC ---
# Comma-separated STUN URIs; TURN is required for ~20% of mobile networks.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_PASSWORD=

# --- S3-compatible media bucket (used when MEDIA_STORAGE_BACKEND=s3) ---
# Railway: `railway bucket credentials --bucket <name>` prints these names.
# AWS_S3_URL_STYLE must match the bucket's urlStyle ("path" or "virtual").
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_URL_STYLE=virtual
AWS_S3_PRESIGN_EXPIRY_SECONDS=3600

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
